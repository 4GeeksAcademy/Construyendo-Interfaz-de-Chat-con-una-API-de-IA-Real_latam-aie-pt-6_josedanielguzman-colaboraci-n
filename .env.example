# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# API Key de Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo a usar. Nota: el enunciado del curso menciona qwen/qwen3.6-27b,
# pero puede no estar disponible en tu cuenta; qwen/qwen3.8-27b es el más
# parecido disponible actualmente.
GROQ_MODEL=qwen/qwen3.8-27b

# Opcional: rate limiting global entre réplicas (Upstash Redis).
# Sin estas variables se usa un limitador en memoria por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
